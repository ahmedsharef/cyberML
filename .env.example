# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Dataset ──────────────────────────────────────────────────────────────────
# Which dataset to use: "nsl_kdd" or "unsw_nb15"
DATASET=nsl_kdd

# ── SMTP Alert Settings (optional — leave blank to only log alerts) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ── App Settings ─────────────────────────────────────────────────────────────
# How fast the live-feed simulation replays (rows per second)
LIVE_FEED_SPEED=2

# Alert severity thresholds (confidence score, 0.0–1.0)
SEVERITY_HIGH_THRESHOLD=0.85
SEVERITY_MEDIUM_THRESHOLD=0.60

# Path overrides (optional)
# DATA_RAW_DIR=data/raw
# DATA_PROCESSED_DIR=data/processed
# MODELS_DIR=models
# DB_PATH=data/cyberattack.db
